{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/private_stage.v1.schema.json",
  "$defs": {
    "s": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "labels",
    "payoff"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.PrivateStageRequest.v1"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls",
        "nature"
      ],
      "properties": {
        "controls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "nature": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    },
    "payoff": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "$ref": "#/$defs/s"
        }
      }
    }
  }
}
