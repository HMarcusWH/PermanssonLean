{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/finite_menu.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "baseline",
    "region",
    "start_state",
    "horizon",
    "value_type",
    "direction",
    "menu"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.FrozenMenuRequest.v1"
    },
    "baseline": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "region": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "start_state": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "horizon": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "value_type": {
      "enum": [
        "survival_horizon",
        "exit_by_horizon"
      ]
    },
    "direction": {
      "enum": [
        "max",
        "min"
      ]
    },
    "menu": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "treated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "target": {
            "enum": [
              "alpha",
              "U",
              "alpha+U"
            ]
          },
          "treated": {
            "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
          }
        }
      }
    }
  }
}
