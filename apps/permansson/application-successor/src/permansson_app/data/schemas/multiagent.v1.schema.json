{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/multiagent.v1.schema.json",
  "$defs": {
    "q": {
      "maxLength": 160,
      "pattern": "^(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
      "type": "string"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "labels",
    "players",
    "common_update",
    "world",
    "treated_player",
    "replacement",
    "anchor"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.FiniteMultiAgentRequest.v1"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common",
        "private",
        "world",
        "actions"
      ],
      "properties": {
        "common": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "private": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "world": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "update"
        ],
        "properties": {
          "action": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/q"
              }
            }
          },
          "update": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/q"
                  }
                }
              }
            }
          }
        }
      }
    },
    "common_update": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/q"
            }
          }
        }
      }
    },
    "world": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/q"
          }
        }
      }
    },
    "treated_player": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "update"
      ],
      "properties": {
        "action": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/q"
            }
          }
        },
        "update": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "$ref": "#/$defs/q"
                }
              }
            }
          }
        }
      }
    },
    "anchor": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "update"
        ],
        "properties": {
          "action": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/q"
              }
            }
          },
          "update": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/q"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
