{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/finite_survival.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "baseline",
    "treated",
    "target",
    "region",
    "comparison_states",
    "horizon"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.FiniteSurvivalComparison.v1"
    },
    "baseline": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "treated": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "target": {
      "enum": [
        "alpha",
        "U",
        "alpha+U"
      ]
    },
    "region": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "comparison_states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "horizon": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    }
  }
}
