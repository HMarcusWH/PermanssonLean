{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/cq1.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "baseline",
    "intervention",
    "region",
    "basin",
    "comparison",
    "property_set",
    "horizon",
    "eta"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.FiniteCQ1Request.v1"
    },
    "baseline": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "treated"
      ],
      "properties": {
        "target": {
          "enum": [
            "alpha",
            "U",
            "alpha+U"
          ]
        },
        "treated": {
          "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
        }
      }
    },
    "region": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "basin": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "comparison": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "property_set": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "horizon": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "eta": {
      "maxLength": 160,
      "pattern": "^(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
      "type": "string"
    }
  }
}
