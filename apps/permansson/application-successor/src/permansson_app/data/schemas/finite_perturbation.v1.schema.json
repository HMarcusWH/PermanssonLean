{
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/finite_perturbation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alternative": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "baseline": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "format": {
      "const": "Permansson.App.FinitePerturbation.v1"
    },
    "horizon": {
      "maximum": 32,
      "minimum": 0,
      "type": "integer"
    },
    "initial_alternative": {
      "items": {
        "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
    },
    "initial_baseline": {
      "items": {
        "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
    },
    "region": {
      "items": {
        "items": false,
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          },
          {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "baseline",
    "alternative",
    "region",
    "initial_baseline",
    "initial_alternative",
    "horizon"
  ],
  "type": "object"
}
