{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/metric.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "baseline",
    "perturbed",
    "metric"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.FiniteMetricRequest.v1"
    },
    "baseline": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "perturbed": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "metric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "b",
          "distance"
        ],
        "properties": {
          "a": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": false
          },
          "b": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": false
          },
          "distance": {
            "maxLength": 160,
            "pattern": "^[1-9][0-9]*(?:/[1-9][0-9]*)?$",
            "type": "string"
          }
        }
      }
    }
  }
}
