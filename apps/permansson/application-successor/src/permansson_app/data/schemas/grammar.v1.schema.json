{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/grammar.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "baseline",
    "patches",
    "admitted_blocks",
    "region",
    "comparison_states",
    "horizon",
    "value_type",
    "four_corners"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.FiniteGrammarRequest.v1"
    },
    "baseline": {
      "$ref": "https://hmwh.se/schemas/permansson/application-successor/1/finite_world.v1.schema.json"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "rows"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "target": {
            "enum": [
              "alpha",
              "U"
            ]
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 72,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "s",
                    "x",
                    "weights"
                  ],
                  "properties": {
                    "s": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                    },
                    "x": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                    },
                    "weights": {
                      "type": "object",
                      "minProperties": 1,
                      "maxProperties": 6,
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "s",
                    "x",
                    "a",
                    "xp",
                    "weights"
                  ],
                  "properties": {
                    "s": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                    },
                    "x": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                    },
                    "a": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                    },
                    "xp": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                    },
                    "weights": {
                      "type": "object",
                      "minProperties": 1,
                      "maxProperties": 6,
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "admitted_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "maxItems": 8,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        }
      }
    },
    "region": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "comparison_states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      }
    },
    "horizon": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "value_type": {
      "enum": [
        "survival_horizon",
        "exit_by_horizon"
      ]
    },
    "four_corners": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alpha_component",
          "U_component"
        ],
        "properties": {
          "alpha_component": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "U_component": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          }
        }
      }
    }
  }
}
