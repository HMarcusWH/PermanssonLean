{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "variables",
    "objective",
    "bounds",
    "constraints"
  ],
  "properties": {
    "format": {
      "const": "Permansson.App.ExactLP.v1"
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sense",
        "coefficients"
      ],
      "properties": {
        "sense": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "coefficients": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "minProperties": 1,
          "maxProperties": 6,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
      },
      "minProperties": 1,
      "maxProperties": 6,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lower",
          "upper"
        ],
        "properties": {
          "lower": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
          },
          "upper": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "coefficients",
          "relation",
          "rhs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "coefficients": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
            },
            "minProperties": 1,
            "maxProperties": 6,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
            }
          },
          "relation": {
            "enum": [
              "<=",
              ">=",
              "="
            ]
          },
          "rhs": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?:0|[1-9][0-9]*|-?[1-9][0-9]*)(?:/[1-9][0-9]*)?$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application-successor/1/lp.v1.schema.json"
}
