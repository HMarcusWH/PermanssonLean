{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmwh.se/schemas/permansson/application/0.1.0/provenance_graph.schema.json",
  "title": "Provenance Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "artifact_ref",
          "depends_on",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "kind": {
            "enum": [
              "EXTERNAL_EVIDENCE",
              "DECLARED_IDENTITY_OR_AXIOM",
              "INDEPENDENT_UPSTREAM_RESULT",
              "DERIVATION",
              "CLAIM"
            ]
          },
          "artifact_ref": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true
    }
  }
}
