set_option autoImplicit false
attribute [local instance] StrategicWorldModel.inducedKernel_isMarkov

variable {Y : Type*} [MetricSpace Y] [MeasurableSpace Y] [Fintype Y]
variable [MeasurableSingletonClass Y] [Nonempty Y]

/-- The invariant fields of this perturbation bundle are GENERATED by finite
class compactness.  Neither invariant probability is supplied as a premise. -/
noncomputable def classPerturbation
    (K Kt : Kernel Y Y) [IsMarkovKernel K] [IsMarkovKernel Kt]
    (C Ct : Set Y) (hC : C ∈ RecurrentClasses K) (hCt : Ct ∈ RecurrentClasses Kt)
    (ρ δ : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hK : IsW1Contraction K ρ) (hδ : ∀ y, W1DualLE (K y) (Kt y) δ) :
    ContractivePerturbation K Kt where
  π := (stationaryForSet K C).toMeasure
  πt := (stationaryForSet Kt Ct).toMeasure
  π_isProb := inferInstance
  πt_isProb := inferInstance
  invariant := (stationaryForSet_spec K hC).1
  invariant_t := (stationaryForSet_spec Kt hCt).1
  ρ := ρ
  δ := δ
  ρ_nonneg := hρ0
  ρ_lt_one := hρ1
  contraction := hK
  defect := hδ
  finite := finite_dual_bound _ _

structure ClassPerturbationData (K Kt : Kernel Y Y) [IsMarkovKernel K] [IsMarkovKernel Kt] where
  baselineClass : Set Y
  perturbedClass : Set Y
  baseline_recurrent : baselineClass ∈ RecurrentClasses K
  perturbed_recurrent : perturbedClass ∈ RecurrentClasses Kt
  baseline_unique : ∀ D ∈ RecurrentClasses K, D = baselineClass
  perturbed_unique : ∀ D ∈ RecurrentClasses Kt, D = perturbedClass
  ρ : ℝ
  δ : ℝ
  rho_nonneg : 0 ≤ ρ
  rho_lt_one : ρ < 1
  contraction : IsW1Contraction K ρ
  defect : ∀ y, W1DualLE (K y) (Kt y) δ

noncomputable def ClassPerturbationData.generated
    {K Kt : Kernel Y Y} [IsMarkovKernel K] [IsMarkovKernel Kt]
    (D : ClassPerturbationData K Kt) : ContractivePerturbation K Kt :=
  classPerturbation K Kt D.baselineClass D.perturbedClass
    D.baseline_recurrent D.perturbed_recurrent D.ρ D.δ
    D.rho_nonneg D.rho_lt_one D.contraction D.defect

theorem recurrentClass_unique_of_contraction
    (K : Kernel Y Y) [IsMarkovKernel K]
    {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hK : IsW1Contraction K ρ)
    {C D : Set Y} (hC : C ∈ RecurrentClasses K) (hD : D ∈ RecurrentClasses K) :
    C = D := by
  obtain ⟨π,hπ,hu⟩ := exists_unique_invariant K hρ0 hρ1 hK
  have hc := stationaryForSet_spec K hC
  have hd := stationaryForSet_spec K hD
  have heq : stationaryForSet K C = stationaryForSet K D :=
    (hu _ hc.1).trans (hu _ hd.1).symm
  have hdC : (stationaryForSet K C).toMeasure D = 1 := by
    rw [heq]
    exact hd.2
  by_contra hne
  have hdis := recurrentClasses_disjoint_of_ne K hC hD hne
  have hunion := measure_union hdis (MeasurableSet.of_discrete : MeasurableSet D)
    (μ := (stationaryForSet K C).toMeasure)
  have hle : (stationaryForSet K C).toMeasure (C ∪ D) ≤ 1 := by
    calc
      _ ≤ (stationaryForSet K C).toMeasure Set.univ :=
        measure_mono (Set.subset_univ (C ∪ D))
      _ = 1 := measure_univ
  rw [hunion,hc.2,hdC] at hle
  norm_num at hle

/-- When both actual finite kernels contract, recurrent classes and stationary
targets are constructed without class-selection or invariant-law premises.
For a separately certified one-class perturbed kernel, the more general data
constructor above only needs contraction of the baseline kernel. -/
noncomputable def dataOfBothContractions
    (K Kt : Kernel Y Y) [IsMarkovKernel K] [IsMarkovKernel Kt]
    {ρ ρt δ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hK : IsW1Contraction K ρ)
    (hρt0 : 0 ≤ ρt) (hρt1 : ρt < 1) (hKt : IsW1Contraction Kt ρt)
    (hδ : ∀ y, W1DualLE (K y) (Kt y) δ) : ClassPerturbationData K Kt := by
  classical
  let C := Classical.choose (recurrentClasses_nonempty K)
  have hC := Classical.choose_spec (recurrentClasses_nonempty K)
  let Ct := Classical.choose (recurrentClasses_nonempty Kt)
  have hCt := Classical.choose_spec (recurrentClasses_nonempty Kt)
  exact ⟨C,Ct,hC,hCt,
    fun D hD => recurrentClass_unique_of_contraction K hρ0 hρ1 hK hD hC,
    fun D hD => recurrentClass_unique_of_contraction Kt hρt0 hρt1 hKt hD hCt,
    ρ,δ,hρ0,hρ1,hK,hδ⟩

variable {S X A V : Type*}
variable [MeasurableSpace S] [MeasurableSpace X] [MeasurableSpace A]
variable [MetricSpace S] [MetricSpace X] [Fintype S] [Fintype X]
variable [MeasurableSingletonClass S] [MeasurableSingletonClass X]
variable [Nonempty S] [Nonempty X] [DecidableEq S] [DecidableEq X]
variable [OpensMeasurableSpace S] [OpensMeasurableSpace X]
variable [StandardBorelSpace S] [StandardBorelSpace X]
variable [MetricSpace V] [MeasurableSpace V] [BorelSpace V] [Fintype V]

theorem model_property_factor
    (M : StrategicWorldModel S X A)
    (C : Set (JointState S X)) (hC : C ∈ RecurrentClasses M.inducedKernel)
    (hone : ∀ D ∈ RecurrentClasses M.inducedKernel, D = C)
    (h : JointState S X → V) (fallback : ProbabilityMeasure V)
    (Φ : C(ProbabilityMeasure V, ℝ)) (y : JointState S X) :
    baselinePropertyValue (property h fallback Φ) M y =
      Φ ((stationaryForSet M.inducedKernel C).map h) := by
  have heq : pathProbability M (MeasureTheory.diracProba y) =
      (⟨canonicalPathLaw M.inducedKernel (Measure.dirac y),inferInstance⟩ :
        ProbabilityMeasure (ℕ → JointState S X)) := by
    apply ProbabilityMeasure.toMeasure_injective
    exact typed_pathLaw_eq_canonical M _
  unfold baselinePropertyValue
  rw [heq]
  exact property_factor_unique_class M.inducedKernel C hC hone h fallback Φ
    (MeasureTheory.diracProba y)

/-- All four components of the original hfac premise, for the SAME property
and descriptor fixed before any kernel comparison. -/
theorem four_actual_factorizations
    (M Mt : StrategicWorldModel S X A)
    {C₀ Cₜ CJ CJt : Set (JointState S X)}
    {FType FtType : Type*} (F : InterventionFamily M FType) (Ft : InterventionFamily Mt FtType)
    (J : AdmissibleStrategicIntervention F) (Jt : AdmissibleStrategicIntervention Ft)
    (hC₀ : C₀ ∈ RecurrentClasses M.inducedKernel)
    (hCₜ : Cₜ ∈ RecurrentClasses Mt.inducedKernel)
    (hCJ : CJ ∈ RecurrentClasses J.intervention.apply.inducedKernel)
    (hCJt : CJt ∈ RecurrentClasses Jt.intervention.apply.inducedKernel)
    (hone₀ : ∀ D ∈ RecurrentClasses M.inducedKernel, D = C₀)
    (honeₜ : ∀ D ∈ RecurrentClasses Mt.inducedKernel, D = Cₜ)
    (honeJ : ∀ D ∈ RecurrentClasses J.intervention.apply.inducedKernel, D = CJ)
    (honeJt : ∀ D ∈ RecurrentClasses Jt.intervention.apply.inducedKernel, D = CJt)
    (h : JointState S X → V) (fallback : ProbabilityMeasure V)
    (Φ : C(ProbabilityMeasure V, ℝ)) (y : JointState S X) :
    baselinePropertyValue (property h fallback Φ) M y =
      Φ ((stationaryForSet M.inducedKernel C₀).map h) ∧
    intervenedPropertyValue (property h fallback Φ) J.intervention y =
      Φ ((stationaryForSet J.intervention.apply.inducedKernel CJ).map h) ∧
    baselinePropertyValue (property h fallback Φ) Mt y =
      Φ ((stationaryForSet Mt.inducedKernel Cₜ).map h) ∧
    intervenedPropertyValue (property h fallback Φ) Jt.intervention y =
      Φ ((stationaryForSet Jt.intervention.apply.inducedKernel CJt).map h) :=
  ⟨model_property_factor M C₀ hC₀ hone₀ h fallback Φ y,
   model_property_factor J.intervention.apply CJ hCJ honeJ h fallback Φ y,
   model_property_factor Mt Cₜ hCₜ honeₜ h fallback Φ y,
   model_property_factor Jt.intervention.apply CJt hCJt honeJt h fallback Φ y⟩

/-- The original margin theorem with its four property-factorization inputs
PROVED from actual finite occupation convergence and with invariant fields
GENERATED by finite class compactness.  The old global dual-Lipschitz
functional hypothesis is retained literally. -/
theorem generated_occupationMargin_robust
    {H Ht : Type*} [MeasurableSpace H] [MeasurableSpace Ht]
    (M Mt : StrategicWorldModel S X A)
    (spec : RegimeSpecification (JointState S X) H)
    (spect : RegimeSpecification (JointState S X) Ht)
    {FType FtType : Type*} (F : InterventionFamily M FType) (Ft : InterventionFamily Mt FtType)
    (J : AdmissibleStrategicIntervention F) (Jt : AdmissibleStrategicIntervention Ft)
    (B : ConstitutiveComparisonSet M spec) (Bt : ConstitutiveComparisonSet Mt spect)
    (hB : Bt.states = B.states)
    (D₀ : ClassPerturbationData M.inducedKernel Mt.inducedKernel)
    (DJ : ClassPerturbationData J.intervention.apply.inducedKernel
      Jt.intervention.apply.inducedKernel)
    (h : JointState S X → V) (hh : Measurable h)
    {Lh : ℝ≥0} (hLh : LipschitzWith Lh h)
    (fallback : ProbabilityMeasure V) (Φ : Measure V → ℝ)
    (hcont : Continuous (fun q : ProbabilityMeasure V => Φ q.toMeasure))
    {LF : ℝ} (hΦ : IsW1LipschitzFunctional Φ LF) :
    |constitutiveMargin Mt spect Ft
        (property h fallback ⟨_,hcont⟩) Bt Jt -
      constitutiveMargin M spec F
        (property h fallback ⟨_,hcont⟩) B J| ≤
      LF * Lh * (D₀.δ / (1-D₀.ρ) + DJ.δ / (1-DJ.ρ)) := by
  apply occupationMargin_robust M Mt spec spect F Ft
    (property h fallback ⟨_,hcont⟩) B Bt hB J Jt
    D₀.generated DJ.generated hh hLh hΦ
  intro y hy
  exact four_actual_factorizations M Mt F Ft J Jt
    D₀.baseline_recurrent D₀.perturbed_recurrent
    DJ.baseline_recurrent DJ.perturbed_recurrent
    D₀.baseline_unique D₀.perturbed_unique DJ.baseline_unique DJ.perturbed_unique
    h fallback ⟨_,hcont⟩ y

end PermanssonResearch.Perturbation.FiniteOccupationFactorization
