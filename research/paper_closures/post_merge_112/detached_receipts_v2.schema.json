{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HMarcusWH/PermanssonLean/blob/research/final-mathematical-closure/research/paper_closures/post_merge_112/detached_receipts_v2.schema.json",
  "title": "Permansson detached source/reviewer evidence v2",
  "description": "External immutable overlay to be authenticated after frozen source H. JSON source flags alone cannot authorize acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "phase",
    "base_sha",
    "head_sha",
    "synthetic_sha",
    "merged_main_sha",
    "evidence_bundle_sha256",
    "source_bound_ci",
    "compiler_axiom_receipts",
    "positive_test_receipts",
    "semantic_negative_receipts",
    "case_decisions",
    "claim_decisions",
    "independent_source_reviews",
    "trusted_axioms"
  ],
  "properties": {
    "format": {
      "const": "Permansson.FinalClosureDetachedReceipts.v2"
    },
    "phase": {
      "enum": [
        "premerge_review",
        "postmerge_acceptance"
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "synthetic_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merged_main_sha": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bound_ci": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "id",
          "head_sha"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "merged_bound_ci": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "id",
          "head_sha"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "compiler_axiom_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "head_sha",
          "path",
          "declaration",
          "source_sha256",
          "statement_sha256",
          "transitive_axioms",
          "compiler_check",
          "compiler_result",
          "check_run_id",
          "axiom_log_member",
          "axiom_log_sha256",
          "case_ids",
          "claim_ids",
          "elaborated_type_sha256",
          "declaration_kind",
          "universe_params_repr"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "check_run_id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "declaration": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_'.]+\\.[A-Za-z0-9_']+$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "statement_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "transitive_axioms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "Classical.choice",
                "Quot.sound",
                "propext"
              ]
            }
          },
          "compiler_check": {
            "const": "research"
          },
          "compiler_result": {
            "const": "PASS"
          },
          "axiom_log_member": {
            "type": "string",
            "minLength": 1
          },
          "axiom_log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "case_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "elaborated_type_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "declaration_kind": {
            "enum": [
              "axiom",
              "definition",
              "theorem",
              "opaque",
              "quotient",
              "inductive",
              "constructor",
              "recursor"
            ]
          },
          "universe_params_repr": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "positive_test_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "head_sha",
          "test_path",
          "test_name",
          "source_sha256",
          "case_ids",
          "positive_control",
          "outcome",
          "compiler_exit_code",
          "log_member",
          "log_sha256",
          "check_run_id",
          "claim_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "check_run_id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "test_path": {
            "type": "string",
            "minLength": 1
          },
          "test_name": {
            "type": "string",
            "pattern": "^test_[A-Za-z0-9_]+$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "positive_control": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "compiled",
              "exit_code",
              "lean_toolchain",
              "log_member",
              "log_sha256"
            ],
            "properties": {
              "compiled": {
                "const": true
              },
              "exit_code": {
                "const": 0
              },
              "lean_toolchain": {
                "const": "4.34.0"
              },
              "log_member": {
                "type": "string",
                "minLength": 1
              },
              "log_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "outcome": {
            "enum": [
              "PASS",
              "REJECTED_SEMANTIC"
            ]
          },
          "compiler_exit_code": {
            "type": "integer"
          },
          "log_member": {
            "type": "string",
            "minLength": 1
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mutant_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "semantic_negative_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "head_sha",
          "test_path",
          "test_name",
          "source_sha256",
          "case_ids",
          "positive_control",
          "outcome",
          "compiler_exit_code",
          "log_member",
          "log_sha256",
          "check_run_id",
          "mutant_source_member",
          "mutant_source_sha256",
          "original_lean_source_path",
          "original_lean_source_sha256",
          "claim_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "check_run_id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "test_path": {
            "type": "string",
            "minLength": 1
          },
          "test_name": {
            "type": "string",
            "pattern": "^test_[A-Za-z0-9_]+$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "positive_control": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "compiled",
              "exit_code",
              "lean_toolchain",
              "log_member",
              "log_sha256"
            ],
            "properties": {
              "compiled": {
                "const": true
              },
              "exit_code": {
                "const": 0
              },
              "lean_toolchain": {
                "const": "4.34.0"
              },
              "log_member": {
                "type": "string",
                "minLength": 1
              },
              "log_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "outcome": {
            "enum": [
              "PASS",
              "REJECTED_SEMANTIC"
            ]
          },
          "compiler_exit_code": {
            "type": "integer"
          },
          "log_member": {
            "type": "string",
            "minLength": 1
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mutant_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mutant_source_member": {
            "type": "string",
            "minLength": 1
          },
          "original_lean_source_path": {
            "type": "string",
            "minLength": 1
          },
          "original_lean_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "case_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "case_id",
          "decision",
          "required_expected_result_sha256",
          "proof_ids",
          "positive_ids",
          "negative_ids",
          "review_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "VERIFIED_SELECTED_SCOPE",
              "VERIFIED_NEGATIVE"
            ]
          },
          "required_expected_result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "proof_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "positive_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "negative_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "claim_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim_id",
          "proof_ids",
          "review_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "proof_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "independent_source_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "actual_synthetic_parents": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "actual_merged_parents": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "synthetic_tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merged_tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "trusted_axioms": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "Classical.choice",
          "Quot.sound",
          "propext"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "premerge_review"
          }
        }
      },
      "then": {
        "properties": {
          "merged_main_sha": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "postmerge_acceptance"
          }
        }
      },
      "then": {
        "properties": {
          "merged_main_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "compiler_axiom_receipts": {
            "items": {
              "properties": {
                "check_run_id": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "positive_test_receipts": {
            "items": {
              "properties": {
                "check_run_id": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "semantic_negative_receipts": {
            "items": {
              "properties": {
                "check_run_id": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
